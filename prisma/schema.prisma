// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ADMIN
  MEMBER
}

enum TokenTypes {
  PASSWORD_RECOVER
}

model Tokens {
  id        String     @id @default(cuid())
  type      TokenTypes
  code      String     @unique @db.VarChar(6)
  createdAt DateTime   @default(now()) @map("created_at")
  expiresAt DateTime?  @map("expires_at")

  employee   Employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String    @map("employee_id")

  @@map("tokens")
}

model Employees {
  id            String    @id @default(cuid())
  name          String
  cpf           String    @unique
  email         String    @unique
  imageUrl      String?   @map("image_url")
  imagePublicId String?   @map("image_public_id")
  passwordHash  String    @map("password_hash")
  role          Roles     @default(MEMBER)
  inactive      DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt() @map("updated_at")

  tokens         Tokens[]
  employeesRooms EmployeesRooms[]

  @@map("employees")
}

model EmployeesRooms {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // (onDelete: Cascade) — quando um funcionário ou sala for deletado, os registros intermediários são removidos automaticamente.
  employees  Employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String    @map("employee_id")
  rooms      Rooms     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String    @map("room_id")

  // Evitar duplicidade, um mesmo funcionário não pode ser vinculado à mesma sala duas vezes.
  @@unique([employeeId, roomId])
  @@map("employees_rooms")
}

model Rooms {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  // Estado onde a sala fica. Obrigatório e sem default no banco: é o servidor que informa a
  // UF a cada estação no registro do WebSocket, e um default silencioso repetiria o erro que
  // o instalador cometia — campo pré-preenchido que ninguém confere. O valor padrão vive no
  // schema Zod da rota de cadastro, onde o cliente ainda pode discordar.
  uf           String    @db.Char(2)
  // Tempo padrão em minutos
  standardTime Int       @default(180) @map("standard_time")
  description  String?
  inactive     DateTime?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt() @map("updated_at")

  employeesRooms EmployeesRooms[]
  computers      Computers[]

  @@map("rooms")
}

model Computers {
  id                   String    @id @default(cuid())
  macCode              String    @unique @map("mac_code")
  description          String
  number               Int
  inUse                Boolean   @default(false) @map("in_use")
  maintenance          DateTime?
  // Última versão do Desktop que a estação informou no `register` do WebSocket.
  //
  // Texto e nada além disso: "1.0.7" não é número e não se ordena por comparação alfabética
  // ("1.0.10" viria antes de "1.0.7"). O teto de 40 acompanha o `MAX_VERSION_LENGTH` do protocolo.
  //
  // NULL é dado legítimo, não pendência: significa que a máquina nunca informou — porque nunca
  // conectou desde este deploy, ou porque o interruptor local de envio está desligado. Registro
  // sem o campo NUNCA apaga o valor guardado, que é a única pista que o suporte tem da máquina.
  appVersion           String?   @map("app_version") @db.VarChar(40)
  // Quando ela informou — NÃO quando esteve online pela última vez.
  //
  // A versão só viaja no `register`, ou seja, a cada conexão. Uma estação um mês no ar sem cair
  // tem carimbo de um mês atrás e está online agora: ler isto como "visto por último" faria o
  // painel mandar ligar para uma unidade que está funcionando. Quem responde "está conectada?"
  // é o mapa em memória do canal, exposto por `GET /computers/online/:roomId?`.
  appVersionReportedAt DateTime? @map("app_version_reported_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt() @map("updated_at")

  room   Rooms  @relation(fields: [roomId], references: [id])
  roomId String @map("room_id")

  // Advogado que está usando o computador no momento (opcional).
  // @unique: garante que o mesmo advogado não use dois computadores ao mesmo tempo.
  // No Postgres, várias linhas com NULL são permitidas (máquinas livres), mas só um
  // computador por advogado não-nulo. A lógica da aplicação deve limpar o campo (null) ao encerrar a sessão.
  currentLawyer   Lawyers? @relation(fields: [currentLawyerId], references: [id], onDelete: SetNull)
  currentLawyerId String?  @unique @map("current_lawyer_id")

  computerSession ComputerSessions[]
  printers        Printers[]

  @@map("computers")
}

model ComputerSessions {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  computer   Computers @relation(fields: [computerId], references: [id], onDelete: Cascade)
  computerId String    @map("computer_id")

  lawyer   Lawyers @relation(fields: [lawyerId], references: [id])
  lawyerId String  @map("lawyer_id")

  // A tabela nasceu apenas com a chave primária. A tela de métricas recorta por período,
  // por sala (via `computer`) e por advogado — sem estes índices cada agregação varre a
  // tabela inteira, e ela só cresce.
  @@index([startedAt])
  @@index([computerId])
  @@index([lawyerId])
  @@map("computer_sessions")
}

model Lawyers {
  id            String    @id @default(cuid())
  name          String
  cpf           String    @unique
  oab           String    @unique
  email         String    @unique
  birth         String
  category      String
  remainingTime Int?      @map("remaining_time")
  lastAccess    DateTime? @map("last_access")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt() @map("updated_at")

  computerSessions ComputerSessions[]
  printers         Printers[]
  currentComputer  Computers?

  @@map("lawyers")
}

model Printers {
  id        String   @id @default(cuid())
  fileUrl   String   @unique @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  computer   Computers @relation(fields: [computerId], references: [id], onDelete: Cascade)
  computerId String    @map("computer_id")
  lawyer     Lawyers   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId   String    @map("lawyer_id")

  @@map("printers")
}

enum AppVersionOrigins {
  /// Chegou pelo `POST /app/version`, no instante da publicação. É a fonte.
  PUBLISHER
  /// Chegou pelo job que espelha o arquivo público. É a rede de segurança.
  MIRROR
}

/// Versões do Desktop que foram publicadas — a metade que faltava para o painel responder
/// "quais máquinas estão atrasadas".
///
/// A outra metade já existe: `computers.appVersion`, que cada estação anuncia no `register`.
///
/// É histórico, e não uma linha só que se sobrescreve: uma linha por versão publicada responde de
/// graça "quando a 1.0.8 saiu, com que notas", que hoje só existe no terminal de quem publicou. A
/// **versão vigente** é a última criada — e é a guarda anti-regressão de `save-published-version.ts`
/// que garante isso, recusando gravar uma versão mais velha que a que já está aqui.
model AppVersions {
  id String @id @default(cuid())

  /// O número que o painel compara com o de cada estação. Texto, pelo mesmo motivo de
  /// `computers.appVersion`: "1.0.10" não se ordena por comparação alfabética.
  version String @unique @db.VarChar(40)

  /// O envelope assinado **exatamente como chegou**, sem reserializar.
  ///
  /// Guardar objeto e remontar na saída reordena chaves e reindenta o JSON. A fase 2
  /// (`GET /app/version`) devolve este campo byte a byte às estações, e a estação recusa em
  /// silêncio o que não confere. Guarde texto, devolva texto.
  envelope String

  /// `geradoEm` de dentro do manifesto — quando a versão foi publicada, não quando a API soube.
  /// Opcional porque o campo é do arquivo, e um manifesto sem ele ainda serve para comparar versão.
  generatedAt DateTime? @map("generated_at")

  /// `notas` do manifesto: texto em português, escrito para o funcionário ler no painel antes de
  /// mandar atualizar. É o que o diálogo mostra em "o que muda nesta versão".
  notes String?

  /// `implantacao` do manifesto (`{ percentual, macs }`) — a onda que o publicador definiu.
  ///
  /// Guardado como veio, sem interpretar: enquanto a fase 2 não existir, quem filtra a onda é o
  /// cliente, e a API só precisa saber exibir.
  rollout Json?

  /// Por qual das duas fontes esta linha chegou. Puro diagnóstico: "a publicação avisou, ou o
  /// espelho é que descobriu?" — a pergunta que se faz quando o painel demora a mostrar a versão.
  origin AppVersionOrigins

  /// `ETag` da última leitura do arquivo público. É o que faz o job perguntar com `If-None-Match` e
  /// receber `304` sem corpo na esmagadora maioria das rodadas.
  etag String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@map("app_versions")
}
