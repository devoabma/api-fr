{
  "name": "api-fr",
  "version": "1.0.0",
  "description": "API-FR é uma API desenvolvida para o projeto SalaLivre. Uma plataforma integrada de gestão de espaços tecnológicos voltada para os escritórios compartilhados e salas de fórum da OAB Maranhão.",
  "main": "src/http/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "start": "node build/http/server.js",
    "email": "email dev --dir src/utils/emails",
    "build": "tsup",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy && prisma db seed"
  },
  "keywords": [],
  "author": {
    "name": "Hilquias Ferreira Melo",
