# App
NODE_ENV="dev"
API_PORT="3333"
# IP real do cliente para o rate limit: "false" (sem proxy), "true", nº de proxies ("1") ou CIDRs confiáveis
TRUST_PROXY="loopback,uniquelocal" # Definir isso aqui em produção para que o rate limit funcione corretamente
TIMEZONE="America/Fortaleza"
# "true" libera computador para advogados(as) inadimplentes (determinação da OAB). Padrão: "false"
ALLOW_DEFAULTING_LAWYERS="false"
# Origem exata do front web (esquema + host + porta). Governa o CORS e os links de e-mail.
# Sem caminho e SEM barra no fim: o header `Origin` do navegador nunca tem uma, e a comparação é exata.
WEB_URL="http://localhost:3000"
DOMAIN_URL="localhost"
TOKEN_COOKIE_NAME="@my-token"
CPF_ADMIN="00000000000"
PASSWORD_ADMIN="my-secret-password"
EMAIL_ADMIN="my-email@example.com"

# Atualização do Desktop
# Arquivo público e assinado que as estações já consultam. O job de espelho lê daqui de 5 em 5 minutos.
APP_MANIFEST_URL="https://salalivre.app/versao.json"
# Token que o `publicar.ps1` apresenta em POST /app/version. SEM ele a rota recusa tudo (padrão seguro).
# NÃO é a chave que assina o manifesto — essa nunca sai do cofre de quem publica.
# Mínimo de 32 caracteres. Gerar com: openssl rand -hex 32
APP_VERSION_PUBLISH_TOKEN=""
# Chave PUBLICA do publicador (DER/SPKI em base64) para conferir a assinatura do manifesto na entrada.
# Vazia = conferencia desligada. NAO e segredo: ja viaja dentro de todo executavel instalado no parque.
# Quem valida de verdade e cada estacao; esta conferencia so evita exibir ou servir arquivo corrompido.
APP_MANIFEST_PUBLIC_KEY=""

# Prisma ORM
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=verify-full&channel_binding=require"

# E-mail Resend
RESEND_API_KEY="your-resend"

# Json Web Token
JWT_SECRET="your-jwt-secret"

# Supabase Upload
PUBLIC_SUPABASE_URL="https://your-supabase-url.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Totvs Protheus
API_PROTHEUS_DATA_URL="route-to-data-api"